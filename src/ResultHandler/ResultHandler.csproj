<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>ResponseResultHandler</PackageId>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>Response Result Handler</Title>
    <Version>11.0.0</Version>
    <Product>ResponseResultHandler</Product>
    <Description>Response Utility Library is a library designed for streamlined handling of response results, supporting success, error, and data outcomes in .NET applications. Within this library, the ResultHandler project serves as a versatile utility for managing result handling and responses efficiently across different use cases.</Description>
    <PackageIcon>ResultHandlerIcon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>Response  response Result result Handler handler CQRS cqrs MediatR  mediatR NetCore netCore Core core .NET .net ProblemDetails RFC9457</PackageTags>
    <PackageReleaseNotes>v11: Decoupled from HttpStatusCode via new ResultStatus enum, added Results.cs factory facade, RFC 9457 Problem Details support via ResultHandler.AspNetCore, custom JSON serialization. Old members (StatusMessage/StatusCode/ResultData) preserved as obsolete for backward compatibility.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="ResultHandlerIcon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ResultHandler.Tests" />
  </ItemGroup>

</Project>
